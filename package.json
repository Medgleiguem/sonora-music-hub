{
  "name": "sonora-music-hub",
  "private": true,
  "version": "1.2.2",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "node scripts/postinstall.mjs",
    "predev": "node scripts/setup-media.mjs",
    "prebuild": "node scripts/setup-media.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "build:mobile": "node scripts/build-mobile.mjs && cap sync android",
    "build:android": "npm run build:mobile && cd android && ./gradlew assembleDebug",
    "package:android": "node scripts/package-android-release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/core": "8.5.1",
    "@vercel/analytics": "^2.0.1",
    "ffmpeg-static": "5.3.0",
    "idb": "^8.0.3",
    "jsmediatags": "^3.9.7",
    "lucide-react": "^0.468.0",
    "next": "^16.3.8",
    "postcss": "8.5.28",
    "react": "^19.2.7",
    "react-dom": "^19.3.1",
    "react-youtube": "^10.1.0"
  },
  "overrides": {
    "postcss": "8.5.28"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@playwright/test": "^1.63.0",
    "esbuild": "0.28.2"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Medgleiguem/sonora-music-hub.git"
  },
  "homepage": "https://github.com/Medgleiguem/sonora-music-hub",
  "bugs": {
    "url": "https://github.com/Medgleiguem/sonora-music-hub/issues"
  },
  "author": "Med Gleiguem"
}
