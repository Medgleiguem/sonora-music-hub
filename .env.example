# Optional server-only key. Never prefix this key with NEXT_PUBLIC_ or expose it to the browser.
# If empty, local/prod search falls back to the downloader worker.
YOUTUBE_API_KEY=your_youtube_data_api_key
YOUTUBE_REGION=US

# Set true when either YOUTUBE_API_KEY or the protected downloader worker is configured.
NEXT_PUBLIC_YOUTUBE_ENABLED=true
NEXT_PUBLIC_YOUTUBE_REGION=US

# Server-side URL for the separate yt-dlp + FFmpeg worker.
DOWNLOADER_URL=http://127.0.0.1:8787
DOWNLOADER_API_KEY=replace_with_a_long_random_secret

# Worker-only. Add your production and preview app origins, comma-separated.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional worker remedies when YouTube blocks a hosting-provider IP.
# Prefer a reputable static residential proxy. Keep credentials server-side.
YT_DLP_PROXY=http://username:password@proxy.example.com:8080
# On Render, secret files are mounted under /etc/secrets.
YT_DLP_COOKIES_PATH=/etc/secrets/youtube-cookies.txt

# Optional: enables the independent Jamendo catalog.
NEXT_PUBLIC_JAMENDO_CLIENT_ID=your_jamendo_client_id
