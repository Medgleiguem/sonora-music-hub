# All features run inside this Next.js app. No Render worker or shared worker secret.
NEXT_PUBLIC_YOUTUBE_ENABLED=true

# Optional: use the official Data API for faster YouTube search.
# Without it, the bundled yt-dlp handles search within Next.js.
YOUTUBE_API_KEY=
YOUTUBE_REGION=US
NEXT_PUBLIC_YOUTUBE_REGION=US

# Optional independent music catalog.
NEXT_PUBLIC_JAMENDO_CLIENT_ID=

# Optional trusted server-side proxy if YouTube rejects the hosting IP.
YT_DLP_PROXY=
# Optional private cookies file path for self-hosted/local use.
YT_DLP_COOKIES_PATH=

# Playlist lookup limit (1-100). Videos are downloaded sequentially.
PLAYLIST_MAX_ITEMS=100

# Optional local binary overrides; normally leave unset.
# YT_DLP_PATH=/absolute/path/to/yt-dlp
# FFMPEG_PATH=/absolute/path/to/ffmpeg
